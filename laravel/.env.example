APP_NAME=Laravel
APP_ENV=local
APP_KEY=

# SECURE BY DEFAULT.
# Copy this file to .env and you get the safe values, not the development ones.
# For a real deployment set APP_ENV=production AND APP_DEBUG=false; `php artisan
# security:audit` fails the build while either is wrong.
#
# APP_DEBUG=true renders stack traces, file paths, SQL and environment values
# to whoever triggers the error. It is a development convenience, not a default.
APP_DEBUG=false
APP_URL=https://rentflow.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ---------------------------------------------------------------------------
# Password hashing
# ---------------------------------------------------------------------------
# 12 is a deliberate trade: slow enough to make offline cracking expensive,
# fast enough that signing in still feels instant.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Legacy sign-in bridge  (REMOVED at cutover)
# ---------------------------------------------------------------------------
# The old PHP app shared an HS256 JWT with this one so a user signed in to either
# was signed in to both. That bridge is gone, along with the shared secret.
# There is deliberately no JWT_SECRET setting: sessions are the only way in.

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# debug logs request bodies, which include passwords and reset codes.
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Session files on disk are readable by anything on the host unless encrypted.
SESSION_ENCRYPT=true

# Refuse to send the session cookie over plain HTTP, so it cannot be sniffed.
# Requires the site to actually serve HTTPS.
SESSION_SECURE_COOKIE=true

# 'lax' still sends the cookie on top-level navigation, which is what lets a
# renter follow a link from an emailed invoice.
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
