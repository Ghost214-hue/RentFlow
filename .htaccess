# RentaFlow - Main .htaccess Configuration
# Deployment: /RentalFlow subdirectory

# Point directory requests to the frontend index
DirectoryIndex frontend/public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Set base path for rewrite rules
    RewriteBase /RentalFlow/

    # Security: Block access to sensitive files
    <FilesMatch "\.(env|log|sql|md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    <FilesMatch "^(composer\.json|composer\.lock|package\.json|\.git)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # API Routes - forward to backend
    RewriteRule ^api(/.*)?$ backend/public/index.php [QSA,L]

    # Static Assets - serve directly from frontend/public
    RewriteRule ^css/(.*)$ frontend/public/css/$1 [QSA,L]
    RewriteRule ^js/(.*)$ frontend/public/js/$1 [QSA,L]
    RewriteRule ^images/(.*)$ frontend/public/images/$1 [QSA,L]
    RewriteRule ^favicon\.ico$ frontend/public/favicon.ico [L]

    # Auth Pages
    RewriteRule ^signin$ frontend/public/signin.php [QSA,L]
    RewriteRule ^signup$ frontend/public/signup.php [QSA,L]
    RewriteRule ^forgot-password$ frontend/public/forgot-password.php [QSA,L]
    RewriteRule ^setup-password$ frontend/public/setup-password.php [QSA,L]
    RewriteRule ^terms-and-conditions$ frontend/pages/terms-and-conditions.php [QSA,L]

    # Frontend Pages - route through index.php for SPA fallback
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-zA-Z0-9_-]+)$ frontend/public/index.php [QSA,L]

    # SPA fallback for any other requests
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ frontend/public/index.php [QSA,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# MIME Types
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/gif .gif
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType font/woff2 .woff2
    AddType font/woff .woff
</IfModule>

# Disable directory listing
Options -Indexes