# RentFlow Environment Configuration
# Copy this to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rentflow
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=rentflow_jwt_secret_key_change_this

# Application
APP_URL=http://localhost/rentflow
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080
APP_VERSION=1.0

# Email / SMTP (Gmail example)
MAIL_USE_SMTP=true
