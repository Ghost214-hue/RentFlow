# RentFlow Environment Configuration
# Copy this to .env and fill in your values

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=rentflow
DB_USER=root
DB_PASS=

# JWT
# IMPORTANT: Generate a secure secret (minimum 32 characters)
# Run: openssl rand -base64 32
JWT_SECRET=rentflow_jwt_secret_key_change_this

# Application
APP_URL=http://localhost/rentflow
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080
APP_VERSION=1.0

# Email / SMTP Configuration
# IMPORTANT: Use environment variables or a secrets manager in production.
# Never commit actual credentials to version control.
MAIL_USE_SMTP=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=RentFlow
MAIL_ENCRYPTION=tls
