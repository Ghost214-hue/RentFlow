# RentaFlow Production Environment Configuration
# DO NOT commit this file to version control
# Copy from .env.example and update all values for production

# Database
DB_HOST=your-production-db-host
DB_PORT=3306
DB_NAME=rentaflow_prod
DB_USER=rentaflow_user
DB_PASS=your-secure-password

# JWT - Generate with: openssl rand -base64 32
JWT_SECRET=generate-a-new-secure-secret-here

# Application
APP_URL=https://yourdomain.com
CORS_ALLOWED_ORIGINS=https://rentaflow.co.ke,https://www.rentalflow.co.ke
APP_VERSION=1.0

# Email / SMTP Configuration
MAIL_USE_SMTP=true
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=rentalflow.realestate@gmail.com
MAIL_PASSWORD=xrntlehpunnqjyga
MAIL_FROM_EMAIL=noreply@rentalflow.co.ke
MAIL_FROM_NAME=RentaFlow
MAIL_ENCRYPTION=tls

# SSL
FORCE_HTTPS=true

# Security
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Logging
LOG_LEVEL=error
LOG_PATH=/var/www/rentaflow/logs
